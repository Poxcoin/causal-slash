{
  "strict-protocol-enforcer": {
    "PreToolUse": [
      {
        "matcher": "write_to_file|replace_file_content|run_command",
        "hooks": [
          {
            "type": "command",
            "command": "/home/minus/.gemini/config/hooks/strict_enforcer.py",
            "timeout": 10
          }
        ]
      }
    ],
    "PreInvocation": [
      {
        "type": "command",
        "command": "/home/minus/.gemini/config/hooks/strict_enforcer.py",
        "timeout": 5
      }
    ],
    "Stop": [
      {
        "type": "command",
        "command": "/home/minus/.gemini/config/hooks/strict_enforcer.py",
        "timeout": 10
      }
    ]
  }
}
