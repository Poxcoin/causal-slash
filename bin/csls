# CSLS - sovereign terminal coding agent. Just run: csls
set -e

SOURCE="${BASH_SOURCE[0]}"
while [ -h "$SOURCE" ]; do
    DIR="$( cd -P "$( dirname "$SOURCE" )" >/dev/null 2>&1 && pwd )"
    SOURCE="$(readlink "$SOURCE")"
    [[ $SOURCE != /* ]] && SOURCE="$DIR/$SOURCE"
done
REPO_DIR="$( cd -P "$( dirname "$SOURCE" )/.." >/dev/null 2>&1 && pwd )"

# Long-context model: the default Ollama window (2048 tokens) is too small to keep a conversation.
if command -v ollama >/dev/null 2>&1 && ! ollama list 2>/dev/null | grep -q '^csls-coder'; then
    ollama create csls-coder -f "$REPO_DIR/scripts/csls_coder.Modelfile" >/dev/null 2>&1 || true
fi

exec python3 "$REPO_DIR/terminal/csls.py" "$@"
